@@ -14,7 +14,7 @@ public final class MoonriseCommon {
     private static final Logger LOGGER = LogUtils.getClassLogger();
 
 
-    public static final long WORKER_QUEUE_HOLD_TIME = (long)(5.0e6); // 5ms
+    public static final long WORKER_QUEUE_HOLD_TIME = (long)(2.0e6); // 2ms - Optimized: reduced from 5ms for faster task processing
     public static final BalancedPrioritisedThreadPool WORKER_POOL = new BalancedPrioritisedThreadPool(
         WORKER_QUEUE_HOLD_TIME,
             new Consumer<>() {
@@ -37,9 +37,10 @@ public final class MoonriseCommon {
     public static final BalancedPrioritisedThreadPool.OrderedStreamGroup SERVER_GROUP = MoonriseCommon.WORKER_POOL.createOrderedStreamGroup();
 
     public static void adjustWorkerThreads(final int configWorkerThreads, final int configIoThreads) {
-        int defaultWorkerThreads = OSNuma.getNativeInstance().getTotalCores();
+        // Optimized: Use 1.5x cores for more parallel chunk generation capacity
+        int defaultWorkerThreads = (int)(OSNuma.getNativeInstance().getTotalCores() * 1.5);
         if (defaultWorkerThreads <= 4) {
-            defaultWorkerThreads = defaultWorkerThreads <= 2 ? 2 : 4;
+            defaultWorkerThreads = defaultWorkerThreads <= 2 ? 4 : 6;
         }
         defaultWorkerThreads = Integer.getInteger(PlatformHooks.get().getBrand() + ".WorkerThreadCount", Integer.valueOf(defaultWorkerThreads));
 
@@ -49,7 +50,7 @@ public final class MoonriseCommon {
             workerThreads = defaultWorkerThreads;
         }
 
-        final int ioThreads = Math.max(2, configIoThreads <= 0 ? OSNuma.getNativeInstance().getTotalCores() / 2 : configIoThreads);
+        final int ioThreads = Math.max(4, configIoThreads <= 0 ? OSNuma.getNativeInstance().getTotalCores() : configIoThreads);
 
         WORKER_POOL.adjustThreadCount(workerThreads);
         IO_POOL.adjustThreadCount(ioThreads);
@@ -57,7 +58,7 @@ public final class MoonriseCommon {
         LOGGER.info(PlatformHooks.get().getBrand() + " is using " + workerThreads + " worker threads, " + ioThreads + " I/O threads");
     }
 
-    public static final long IO_QUEUE_HOLD_TIME = (long)(5.0e6); // 5ms
+    public static final long IO_QUEUE_HOLD_TIME = (long)(2.0e6); // 2ms - Optimized: reduced from 5ms for faster I/O processing
     public static final BalancedPrioritisedThreadPool IO_POOL = new BalancedPrioritisedThreadPool(
         IO_QUEUE_HOLD_TIME,
             new Consumer<>() {
