     private static final java.util.function.BiPredicate<ItemStack, Integer> IS_EMPTY_TEST = (itemStack, i) -> itemStack.isEmpty();
     // Paper end - Perf: Optimize Hoppers
 
+    private static boolean tentaclesIsCachedHopperContainerValid(Level level, Container container) {
+        if (container == null) {
+            return false;
+        }
+        if (container instanceof CompoundContainer compound) {
+            return tentaclesIsCachedHopperContainerValid(level, compound.container1)
+                && tentaclesIsCachedHopperContainerValid(level, compound.container2);
+        }
+        if (container instanceof BlockEntity blockEntity) {
+            return !blockEntity.isRemoved() && level.getBlockEntity(blockEntity.getBlockPos()) == blockEntity;
+        }
+        if (container instanceof Entity entity) {
+            return entity.isAlive() && !entity.isRemoved();
+        }
+        return false;
+    }
