+    // Tentacles start - SWM-style Buffered Format: flush buffered writes
+    private synchronized void flushWriteBuffer() {
+        if (writeBuffer.isEmpty()) {
+            return;
+        }
+        
+        try {
+            // Flush all buffered chunks in batch for better I/O performance
+            ChunkPos pos;
+            int flushed = 0;
+            while ((pos = writeQueue.poll()) != null && flushed < WRITE_BUFFER_SIZE) {
+                CompoundTag data = writeBuffer.remove(pos);
+                if (data != null) {
+                    try {
+                        this.storage.write(pos, data);
+                        flushed++;
+                    } catch (IOException e) {
+                        LOGGER.error("Failed to write buffered chunk {} for {}", pos, this.dataFixType, e);
+                    }
+                }
+            }
+            bufferedCount = writeBuffer.size();
+        } catch (Exception e) {
+            LOGGER.error("Error flushing write buffer for {}", this.dataFixType, e);
+        }
+    }
+    // Tentacles end
