     public static final TicketType UNLOAD_COOLDOWN = ChunkSystemTicketType.create("chunk_system:unload_cooldown", null, 5L * 20L);
 
+    /**
+     * Thread-local scratch lists for ticket propagation (C2ME-style: avoid allocating new lists on every distance-manager pass).
+     * Ticket updates do not nest on the same thread ({@link #BLOCK_TICKET_UPDATES}).
+     */
+    private static final ThreadLocal<ArrayList<ChunkProgressionTask>> TENTACLES_TLS_SCHEDULED_TASKS =
+        ThreadLocal.withInitial(() -> new ArrayList<>(64));
+    private static final ThreadLocal<ArrayList<NewChunkHolder>> TENTACLES_TLS_CHANGED_FULL =
+        ThreadLocal.withInitial(() -> new ArrayList<>(64));
+    private static final ThreadLocal<ArrayList<NewChunkHolder>> TENTACLES_TLS_PENDING_FULL_PASS =
+        ThreadLocal.withInitial(() -> new ArrayList<>(32));
+
+    private static ArrayList<ChunkProgressionTask> tentaclesBorrowScheduledTasks() {
+        final ArrayList<ChunkProgressionTask> list = TENTACLES_TLS_SCHEDULED_TASKS.get();
+        list.clear();
+        return list;
+    }
+
+    private static ArrayList<NewChunkHolder> tentaclesBorrowChangedFull() {
+        final ArrayList<NewChunkHolder> list = TENTACLES_TLS_CHANGED_FULL.get();
+        list.clear();
+        return list;
+    }
+
+    private static ArrayList<NewChunkHolder> tentaclesBorrowPendingFullPass() {
+        final ArrayList<NewChunkHolder> list = TENTACLES_TLS_PENDING_FULL_PASS.get();
+        list.clear();
+        return list;
+    }
+
     private static final long NO_TIMEOUT_MARKER = Long.MIN_VALUE;
     public final ReentrantAreaLock ticketLockArea;
 
