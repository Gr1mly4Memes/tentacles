@@ -62,10 +62,23 @@ import java.util.concurrent.atomic.AtomicBoolean;
 import java.util.concurrent.atomic.AtomicLong;
 import java.util.function.Consumer;
 
+/**
+ * Tentacles chunk scheduling follows the same design goals as
+ * <a href="https://github.com/RelativityMC/C2ME-fabric">C2ME</a> (concurrent chunk management): dedicated worker pools for
+ * parallel generation, loading, compression, saving, and asynchronous chunk I/O, coordinated with ticket-level updates.
+ * C2ME achieves this on Fabric via mixins; here Paper’s Moonrise implementation provides the pipelines below.
+ */
 public final class ChunkTaskScheduler {
 
     private static final Logger LOGGER = LogUtils.getClassLogger();
 
+    /**
+     * Shift passed to {@link AreaDependentQueue}: smaller values subdivide the world into more independent scheduling
+     * cells so parallel generation can use more CPU cores (same goal as C2ME’s global executor parallelism).
+     * Paper’s default is coarser; Tentacles uses {@code 1} → 2×2 chunks per cell for higher throughput on multi-core hosts.
+     */
+    private static final int TENTACLES_AREA_DEPENDENT_QUEUE_SHIFT = 1;
+
     public static final TicketType CHUNK_LOAD = ChunkSystemTicketType.create("chunk_system:chunk_load", Long::compareTo);
     private static final AtomicLong CHUNK_LOAD_IDS = new AtomicLong();
 
@@ -277,7 +290,7 @@ public final class ChunkTaskScheduler {
 
         this.parallelGenExecutor = MoonriseCommon.SERVER_GROUP.createExecutor();
         this.loadExecutor = MoonriseCommon.SERVER_GROUP.createExecutor();
-        this.radiusAwareScheduler = new AreaDependentQueue(this.parallelGenExecutor, 2); // 2 -> 4x4 grid for more parallelism
+        this.radiusAwareScheduler = new AreaDependentQueue(this.parallelGenExecutor, TENTACLES_AREA_DEPENDENT_QUEUE_SHIFT);
         this.ioExecutor = MoonriseCommon.SERVER_IO_GROUP.createExecutor();
         // we need a separate executor here so that on shutdown we can continue to process I/O tasks
         this.compressionExecutor = MoonriseCommon.SERVER_GROUP.createExecutor();
