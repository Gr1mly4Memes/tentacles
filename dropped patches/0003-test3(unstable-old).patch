+    private void updateCachedTickTime(long tickTimeNanos) {
+        this.cachedTickTimes[this.cachedTickTimeIndex] = tickTimeNanos;
+        this.cachedTickTimeIndex = (this.cachedTickTimeIndex + 1) % this.cachedTickTimes.length;
+        
+        // Calculate smoothed average
+        long sum = 0;
+        for (long time : this.cachedTickTimes) {
+            sum += time;
+        }
+        long newAverage = sum / this.cachedTickTimes.length;
+        
+        // Apply smoothing to avoid sudden changes
+        this.cachedTickTimeAverage = (long)(this.cachedTickTimeAverage * TICK_TIME_SMOOTHING 
+            + newAverage * (1.0F - TICK_TIME_SMOOTHING));
+    }
