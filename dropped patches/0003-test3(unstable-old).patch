+    // Tentacles start - Pathfinding optimization
+    /**
+     * Checks if the mob should skip pathfinding this tick based on optimization settings.
+     * Fish and other mobs out of player view pathfind less frequently to reduce server load.
+     */
+    public boolean shouldSkipPathfinding() {
+        if (this.level().isClientSide()) {
+            return false;
+        }
+        
+        // Check if this is a fish type entity (water mob with simple AI)
+        boolean isFish = this.getType().is(net.minecraft.tags.EntityTypeTags.AQUATIC) 
+            || this instanceof net.minecraft.world.entity.animal.fish.AbstractFish;
+        
+        if (isFish) {
+            // Fish only pathfind every 20 ticks
+            return this.pathfindingTickCounter % FISH_PATHFIND_INTERVAL != 0;
+        }
+        
+        // Check if mob is far from any player (out of visibility)
+        boolean outOfView = true;
+        if (this.level() instanceof ServerLevel serverLevel) {
+            for (Player player : serverLevel.players()) {
+                if (player.distanceToSqr(this) < 1024.0) { // 32 blocks squared
+                    outOfView = false;
+                    break;
+                }
+            }
+        }
+        
+        if (outOfView) {
+            // Mobs out of player view only pathfind every 10 ticks
+            return this.pathfindingTickCounter % OUT_OF_VIEW_PATHFIND_INTERVAL != 0;
+        }
+        
+        return false;
+    }
+    // Tentacles end
+
