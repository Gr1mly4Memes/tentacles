     static CompletableFuture<ChunkAccess> light(WorldGenContext worldGenContext, ChunkStep step, StaticCache2D<GenerationChunkHolder> cache, ChunkAccess chunk) {
         boolean isLighted = isLighted(chunk);
+
+        // Tentacles start - Lighting Deferral
+        // Defer lighting for chunks far from players to reduce generation lag spikes
+        var optimizer = ca.spottedleaf.moonrise.patches.chunk_system.lod.ChunkGenerationOptimizerManager.getForLevel(worldGenContext.level());
+        if (optimizer != null && !isLighted) {
