+package ca.spottedleaf.moonrise.patches.chunk_system.lod;
+
+import it.unimi.dsi.fastutil.objects.Object2ObjectMap;
+import it.unimi.dsi.fastutil.objects.Object2ObjectOpenHashMap;
+import net.minecraft.server.level.ServerLevel;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Manages ChunkGenerationOptimizer instances per level
+ */
+public class ChunkGenerationOptimizerManager {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger("Tentacles-ChunkOpt");
+    private static final Object2ObjectMap<ServerLevel, ChunkGenerationOptimizer> optimizers = new Object2ObjectOpenHashMap<>();
+
+    /**
+     * Get or create optimizer for a level
+     */
+    public static ChunkGenerationOptimizer getForLevel(ServerLevel level) {
+        return optimizers.computeIfAbsent(level, ChunkGenerationOptimizer::new);
+    }
+
+    /**
+     * Remove optimizer for a level (called when level unloads)
+     */
+    public static void removeForLevel(ServerLevel level) {
+        optimizers.remove(level);
+    }
+
+    /**
+     * Tick all optimizers - call from ServerLevel tick
+     */
+    public static void tickAll() {
+        for (ChunkGenerationOptimizer optimizer : optimizers.values()) {
+            try {
+                optimizer.updateLODLevels();
+                optimizer.processPendingOperations();
+            } catch (Exception e) {
+                LOGGER.error("Error ticking chunk generation optimizer", e);
+            }
+        }
+    }
+
+    /**
+     * Get debug info for all optimizers
+     */
+    public static String getDebugInfo() {
+        StringBuilder sb = new StringBuilder();
+        sb.append("Chunk Generation Optimizers:\n");
+        for (Object2ObjectMap.Entry<ServerLevel, ChunkGenerationOptimizer> entry : optimizers.object2ObjectEntrySet()) {
+            ServerLevel level = entry.getKey();
+            ChunkGenerationOptimizer optimizer = entry.getValue();
+            sb.append("  ").append(level.dimension().identifier())
+              .append(" - Pending Features: ").append(optimizer.getPendingFeatureCount())
+              .append(", Pending Lighting: ").append(optimizer.getPendingLightingCount())
+              .append(", Pending Structures: ").append(optimizer.getPendingStructureCount())
+              .append("\n");
+        }
+        return sb.toString();
+    }
+}
