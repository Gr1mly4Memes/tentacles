+
+            // Check if we should light now or defer
+            if (!optimizer.shouldLightNow(pos)) {
+                // Mark lighting as pending for later computation
+                optimizer.markLightingPending(pos);
+
+                // Return chunk without lighting - it will be lit when player approaches
+                // Chunk is functional but may have incorrect lighting until player gets close
+                return CompletableFuture.completedFuture(chunk);
+            }
+
+            // Lighting will be computed now, mark as done
+            optimizer.markLightingDone(pos);
+        }
+        // Tentacles end - Lighting Deferral
+
         return worldGenContext.lightEngine().lightChunk(chunk, isLighted);
     }
 
